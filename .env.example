# BetPlatform — Environment Variables
# Copy to .env and fill in your values. NEVER commit .env to git.

# ─── Core ──────────────────────────────────────────────────────────────────
SECRET_KEY=your-very-long-random-secret-key-here-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC

# ─── Database ──────────────────────────────────────────────────────────────
# Local dev (SQLite — default, no changes needed):
DATABASE_URL=sqlite:///db.sqlite3

# Production (PostgreSQL):
# DATABASE_URL=postgres://betuser:strongpassword@localhost:5432/betplatform

# ─── Redis (optional — for production caching/sessions) ────────────────────
# REDIS_URL=redis://localhost:6379/0

# ─── Email ─────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@betplatform.com

# ─── CORS (comma-separated) ────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Sports Data APIs ──────────────────────────────────────────────────────
# The Odds API (https://the-odds-api.com) — live sports odds
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# SportsData.io (fixtures, teams, live scores)
SPORTS_DATA_API_KEY=

# ─── International Payment Providers ────────────────────────────────────────
# Stripe — international cards, Apple Pay, Google Pay
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal — international wallets
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ─── Local / African Payment Providers ──────────────────────────────────────
# Flutterwave — MTN, Airtel, Zamtel, VISA, Mastercard (pan-Africa)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-...
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...
FLUTTERWAVE_ENCRYPTION_KEY=

# Paystack — Cards + mobile money (Ghana, Nigeria, Kenya, South Africa)
PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_SECRET_KEY=sk_test_...

# MTN Mobile Money (direct sandbox)
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com

# Airtel Money
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=

# Zamtel Kwacha (Zambia)
ZAMTEL_API_KEY=
